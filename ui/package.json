{
  "name": "smhub-ui",
  "version": "2.0.3",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "The SMHUB web UI (API v2)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "build": "tsc --noEmit && vite build && node scripts/size-report.mjs && node scripts/i18n-report.mjs",
    "preview": "vite preview",
    "i18n": "node scripts/i18n-report.mjs",
    "test": "playwright test",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "lucide-preact": "1.69.0",
    "marked": "18.1.3",
    "preact": "10.29.8",
    "wouter-preact": "3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
